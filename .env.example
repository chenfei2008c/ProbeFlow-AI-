# 复制为 .env 后在本机编辑；不要将真实密钥提交 Git 或发送到聊天。
MODE=mock
# 留空此行即可使用 ~/Library/Application Support/ProbeFlow；必须在仓库之外。
# DATA_DIR=/absolute/path/outside/repository/ProbeFlow
# BACKUP_DIR=/absolute/path/outside/repository/ProbeFlow-backups
PUBLIC_BASE_URL=http://localhost:8765
ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765,http://localhost:5173
# 首次使用 ./scripts/probeflow init-admin；生产环境不内置固定密码。
RETENTION_POLICY=permanent
MAX_ACTIVE_SESSIONS=2
MONTHLY_LIMIT_CNY=100.00
MIN_FREE_BYTES=104857600
TEMP_RETENTION_HOURS=24
BACKUP_COUNT=7
PROVIDER_TIMEOUT_SECONDS=45
# 使用其他模型或地区时，必须在 PRICE_OVERRIDES 中配置匹配的价格。
# 价格单位及完整格式见 docs/provider-compatibility.md；不得填入凭证。
PRICE_OVERRIDES={}
PROVIDER_REGION=cn-beijing
ASR_PROVIDER=bailian
INTERVIEW_PROVIDER=bailian
TTS_PROVIDER=bailian
REPORT_PROVIDER=bailian
# 可换成账户对应的业务空间专属 HTTPS 地址；四角色分别配置。
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
INTERVIEW_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
REPORT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_MODEL=qwen3-asr-flash
INTERVIEW_MODEL=qwen-plus
TTS_MODEL=qwen3-tts-flash
REPORT_MODEL=qwen-plus
ASR_KEY_ENV=DASHSCOPE_API_KEY
INTERVIEW_KEY_ENV=DASHSCOPE_API_KEY
TTS_KEY_ENV=DASHSCOPE_API_KEY
REPORT_KEY_ENV=DASHSCOPE_API_KEY
TTS_VOICE=Cherry
DASHSCOPE_API_KEY=
